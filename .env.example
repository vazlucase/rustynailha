# =============================================================
# RUSTY NA ILHA — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# =============================================================

# Postgres da Vercel (colado do painel Vercel → Storage → Postgres)
POSTGRES_URL=postgres://user:password@host:5432/db?sslmode=require

# URL pública do site (usada para validar Origin em mutações — CSRF)
SITE_URL=https://rustynailha.com.br

# Credenciais do primeiro admin (usadas por `npm run create-admin`)
# Troque ANTES de criar; a senha é gravada apenas como hash scrypt no banco.
ADMIN_USER=melhorAdmin
ADMIN_PASS=senha-bem-longa-e-forte-ao-menos-12